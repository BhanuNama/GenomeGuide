# LLM API Key (Groq LPU)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# NCBI E-utilities (Optional — increases rate limit from 3 req/sec to 10 req/sec)
NCBI_API_KEY=

# LangSmith Tracing (Optional — sign up at smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=GenomeGuide

